# Maintainer: Hierapolis Linux <twinboi@hierapolis-linux.org>
pkgname=hierapolis-theme
pkgver=0.1.0
pkgrel=1
pkgdesc="Hierapolis DE — Glassmorphism GTK4 theme (dark + light variants)"
arch=('any')
url="https://github.com/Furkan-Tech26/Hierapolis-Linux-Pre-Alpha"
license=('CC-BY-SA-4.0')
depends=('gtk4')
makedepends=('librsvg')
source=()
sha256sums=()

build() {
	rm -rf "$srcdir/raster"
	mkdir -p "$srcdir/raster"
	for name in default glass dark; do
		rsvg-convert -w 1920 -h 1080 "$startdir/wallpapers/hierapolis-${name}.svg" \
			-o "$srcdir/raster/${name}.png"
	done
}

package() {
	# GTK4 theme
	install -dm755 "$pkgdir/usr/share/themes/Hierapolis-Glass/gtk-4.0/"
	install -m644 "$startdir/gtk-4.0/gtk.css" "$pkgdir/usr/share/themes/Hierapolis-Glass/gtk-4.0/gtk.css"
	install -m644 "$startdir/gtk-4.0/gtk-dark.css" "$pkgdir/usr/share/themes/Hierapolis-Glass/gtk-4.0/gtk-dark.css"

	# Wallpapers (SVG sources + PNG rasters for swaybg)
	install -dm755 "$pkgdir/usr/share/backgrounds/hierapolis/"
	# NOTE: default.png belongs to hierapolis-artwork (avoids a package file conflict).
	install -m644 "$startdir/wallpapers/hierapolis-default.svg" "$pkgdir/usr/share/backgrounds/hierapolis/default.svg"
	install -m644 "$startdir/wallpapers/hierapolis-glass.svg" "$pkgdir/usr/share/backgrounds/hierapolis/glass.svg"
	install -m644 "$startdir/wallpapers/hierapolis-dark.svg" "$pkgdir/usr/share/backgrounds/hierapolis/dark.svg"
	install -m644 "$srcdir/raster/glass.png" "$pkgdir/usr/share/backgrounds/hierapolis/glass.png"
	install -m644 "$srcdir/raster/dark.png" "$pkgdir/usr/share/backgrounds/hierapolis/dark.png"

	# Icons
	install -dm755 "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
	install -m644 "$startdir/icons/hierapolis-settings.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/hierapolis-settings.svg"
	install -m644 "$startdir/icons/hierapolis-startmenu.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/hierapolis-startmenu.svg"
}

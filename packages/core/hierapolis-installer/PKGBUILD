# Maintainer: Hierapolis Linux <twinboi@hierapolis-linux.org>
pkgname=hierapolis-installer
pkgver=0.1.0
pkgrel=1
pkgdesc="Hierapolis Linux text-mode installer (hierapolis-install command)"
arch=('any')
url="https://github.com/Furkan-Tech26/Hierapolis-Linux-Pre-Alpha"
license=('GPL')
depends=('bash' 'pacman' 'arch-install-scripts' 'util-linux' 'gptfdisk' 'cryptsetup' 'efibootmgr' 'systemd')
source=('hierapolis-install')
sha256sums=('SKIP')

package() {
    install -dm755 "$pkgdir/usr/bin/"
    install -m755 "$srcdir/hierapolis-install" "$pkgdir/usr/bin/hierapolis-install"
}
# Maintainer: Hierapolis Linux <twinboi@hierapolis-linux.org>
pkgname=hierapolis-vpm
pkgver=0.1.0
pkgrel=1
pkgdesc="Hierapolis Package Manager — pacman wrapper with Hierapolis branding (vpm command)"
arch=('any')
url="https://github.com/Furkan-Tech26/Hierapolis-Linux-Pre-Alpha"
license=('GPL')
depends=('pacman')
source=('vpm')
sha256sums=('SKIP')

package() {
	install -dm755 "$pkgdir/usr/bin/"
	install -m755 "$srcdir/vpm" "$pkgdir/usr/bin/vpm"
}
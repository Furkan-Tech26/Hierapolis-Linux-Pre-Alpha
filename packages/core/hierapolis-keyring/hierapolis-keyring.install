post_install() {
    # pacman-key needs gpg; the package depends on gnupg, but stay defensive
    command -v gpg >/dev/null 2>&1 || return 0
    pacman-key --init || true
    pacman-key --populate hierapolis || true
    pacman-key --lsign-key "Hierapolis Linux Build Key <build@hierapolis-linux.org>" 2>/dev/null || true
}

post_upgrade() {
    post_install
}

post_remove() {
    command -v gpg >/dev/null 2>&1 || return 0
    pacman-key --delete "Hierapolis Linux Build Key <build@hierapolis-linux.org>" 2>/dev/null || true
}

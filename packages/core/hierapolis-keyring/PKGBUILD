# Maintainer: Hierapolis Linux <twinboi@hierapolis-linux.org>
pkgname=hierapolis-keyring
pkgver=20250101
pkgrel=2
pkgdesc="Hierapolis Linux PGP keyring (auto-generated locally)"
arch=('any')
url="https://github.com/Furkan-Tech26/Hierapolis-Linux-Pre-Alpha"
license=('GPL')
# pacman-key needs gpg available when the install scriptlet runs
depends=('gnupg')
makedepends=('gnupg')
install=hierapolis-keyring.install
source=()
sha256sums=()

build() {
	# Generate a local keyring for testing
	local tmpdir=$(mktemp -d)
	export GNUPGHOME="$tmpdir"

	gpg --batch --passphrase '' --generate-key <<EOF
%no-protection
Key-Type: RSA
Key-Length: 2048
Name-Real: Hierapolis Linux Build Key
Name-Email: build@hierapolis-linux.org
Expire-Date: 0
%commit
EOF

	gpg --export --armor "Hierapolis Linux Build Key" > "$startdir/hierapolis.gpg"
	rm -rf "$tmpdir"
}

package() {
	install -dm755 "$pkgdir/usr/share/pacman/keyrings/"
	install -m644 "$startdir/hierapolis.gpg" "$pkgdir/usr/share/pacman/keyrings/hierapolis.gpg"
}
post_install() {
	# Append the [hierapolis] repo to pacman.conf if it isn't there yet
	if ! grep -q '^\[hierapolis\]' /etc/pacman.conf; then
		{
			echo ""
			echo "[hierapolis]"
			echo "SigLevel = Optional TrustAll"
			echo "Include = /etc/pacman.d/mirrorlist-hierapolis"
		} >> /etc/pacman.conf
	fi
}

post_upgrade() {
	post_install "$@"
}

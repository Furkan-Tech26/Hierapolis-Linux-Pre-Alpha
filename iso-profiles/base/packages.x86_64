# Hierapolis Linux base packages - minimal bootable system
# Official Arch repos + the local [hierapolis] repo built by build-repo.sh
# NOTE: only repo packages here. AUR packages cannot be used by mkarchiso.

# === Base system ===
base
linux
linux-firmware
intel-ucode
amd-ucode
systemd
systemd-sysvcompat
mkinitcpio
mkinitcpio-archiso

# === Package management + installer tooling ===
pacman
pacman-contrib
arch-install-scripts
sudo

# === Networking ===
networkmanager
dhcpcd
iwd
openssh

# === Filesystem / storage ===
e2fsprogs
dosfstools
btrfs-progs
lvm2
cryptsetup

# === Essential tools ===
bash
coreutils
util-linux
grep
sed
gawk
findutils
diffutils
less
vim
nano
man-db
man-pages
texinfo
which
psmisc
procps-ng
iproute2
inetutils
net-tools
tmux

# === Build tools (for on-device package building) ===
base-devel
git
meson
ninja
cmake
pkgconf

# === System utilities ===
htop
btop
fastfetch
parted
gptfdisk
efibootmgr
reflector

# === Bootloaders ===
grub
syslinux

